table weekly_recalls
	lineageTag: bb9a27f6-1080-4ef8-b954-266732b818f7

	measure 'Weekly recall events' = SUM(weekly_recalls[events])
		formatString: #,0
		lineageTag: e53c0935-016b-4615-b99c-4e696ece4a1e

	measure Average = AVERAGE(weekly_recalls[center])
		formatString: #,0.0
		lineageTag: 52d66855-9668-48e7-9395-1f7b1eeeb8e0

	measure 'Upper limit' = AVERAGE(weekly_recalls[ucl])
		formatString: #,0.0
		lineageTag: 5fad5323-026a-40bf-a9d5-f13bcd0c0567

	measure 'Lower limit' = AVERAGE(weekly_recalls[lcl])
		formatString: #,0.0
		lineageTag: d268f1a6-4cb3-4967-9d58-a9702f1933c4

	column in_last_2_years = weekly_recalls[week] >= EDATE(TODAY(), -24)
