		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: a21cfa6f-5e9f-4bb0-b444-6a6049b94986
		summarizeBy: none
		sourceColumn: injectable

		annotation SummarizationSetBy = Automatic

	column points
