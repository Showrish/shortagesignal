	column reasons
		dataType: string
		lineageTag: b2df1ba0-4d05-4860-a4d1-552b3b50348c
		summarizeBy: none
		sourceColumn: reasons

		annotation SummarizationSetBy = Automatic

	column reported
		dataType: dateTime
		formatString: Short Date
		lineageTag: f61f52a2-7abc-4089-941e-c76c46fcf307
		summarizeBy: none
		sourceColumn: reported

		variation Variation
			isDefault
			relationship: fb01d87c-f009-4c2e-be1e-f8ce57167c69
			defaultHierarchy: LocalDateTable_521fe30f-d26a-40eb-9621-ab7c273ecb68.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition recall_risk = m
		mode: import
		source =
				let
				    Source = DataFile("recall_risk.parquet"),
				    Reported = Table.AddColumn(Source, "reported", each try #date(
				        Number.From(Text.Start([report_date], 4)),
				        Number.From(Text.Middle([report_date], 4, 2)),
				        Number.From(Text.End([report_date], 2))) otherwise null, type date)
				in
				    Reported

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

